# Maintainer: Phosphene-dev <https://github.com/Phosphene-dev>
pkgname=hallucinate
pkgver=0.9.0
pkgrel=1
pkgdesc="Fast desktop music player for the music you own: liquid, cover-coloured, gapless and private (PySide6/QML)"
arch=('any')
url="https://github.com/Phosphene-dev/Hallucinate"
license=('MIT' 'OFL-1.1')
depends=('python' 'pyside6' 'python-mutagen' 'python-keyring' 'python-numpy' 'qt6-multimedia-ffmpeg' 'qt6-declarative')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
optdepends=('gnome-keyring: store Last.fm credentials in the system keyring'
            'kwallet: store Last.fm credentials in the system keyring')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('7959383b0ade92186234fb571c84ed02d97f3471702f92a99f17c14261f18307')

build() {
  cd "Hallucinate-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "Hallucinate-$pkgver"
  python -c "import ast,sys; [ast.parse(open(f).read()) for f in sys.argv[1:]]" hallucinate/*.py hallucinate/core/*.py
}

package() {
  cd "Hallucinate-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 packaging/hallucinate.desktop "$pkgdir/usr/share/applications/hallucinate.desktop"
  for s in 16 24 32 48 64 128 256 512; do install -Dm644 "packaging/icons/hicolor/${s}x${s}/apps/hallucinate.png" "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/hallucinate.png"; done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
