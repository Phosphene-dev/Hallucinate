# Hallucinate without a window, as a systemd user service (your own account, your own sound session).
#
#   mkdir -p ~/.config/systemd/user && cp hallucinate.service ~/.config/systemd/user/
#   systemctl --user enable --now hallucinate
#   loginctl enable-linger "$USER"     # keep it running when you're not logged in
#   hallucinate --pair                 # pair your phone
#
# Add music folders once with `hallucinate --headless /path/to/music` (they're kept), or edit ExecStart.
# Add --network to ExecStart to reach the web interface from other devices. See docs/headless.md.
[Unit]
Description=Hallucinate music player (no window)
Documentation=https://github.com/Phosphene-dev/Hallucinate/blob/main/docs/headless.md
After=network-online.target sound.target pipewire.service pulseaudio.service

[Service]
ExecStart=hallucinate --headless
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes

[Install]
WantedBy=default.target
